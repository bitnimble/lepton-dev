@@ -0,0 +1,90 @@
+import { ControlMessage } from '../controlMessage/ControlMessage';
+import { KeyCodeControlMessage } from '../controlMessage/KeyCodeControlMessage';
+import { TextControlMessage } from '../controlMessage/TextControlMessage';
+import KeyEvent from './android/KeyEvent';
+import { KeyToCodeMap } from './KeyToCodeMap';
+
+// Kept in the field so a backspace on "empty" still produces an input event to forward
+const SENTINEL = ' ';
+
+export interface SoftKeyboardTarget {
+    sendMessage(message: ControlMessage): void;
+}
+
+/** Forwards text typed into a focused off-screen field, which is what opens a phone's on-screen keyboard. */
+export class SoftKeyboardInput {
+    private readonly input: HTMLInputElement;
+    private lastValue = SENTINEL;
+
+    constructor(private readonly target: SoftKeyboardTarget) {
+        const input = document.createElement('input');
+        input.type = 'text';
+        input.autocomplete = 'off';
+        input.spellcheck = false;
+        input.setAttribute('autocapitalize', 'off');
+        input.setAttribute('autocorrect', 'off');
+        input.setAttribute('aria-label', 'Keyboard input');
+        // font-size 16px: smaller makes iOS zoom the page on focus
+        input.style.cssText =
+            'position:fixed;left:0;bottom:0;width:1px;height:1px;opacity:0;font-size:16px;border:0;padding:0;';
+        input.value = SENTINEL;
+        input.addEventListener('input', this.onInput);
+        input.addEventListener('keydown', this.onKeyDown);
+        input.addEventListener('compositionend', this.onInput);
+        document.body.appendChild(input);
+        this.input = input;
+    }
+
+    public focus(): void {
+        this.input.focus();
+        this.input.setSelectionRange(this.input.value.length, this.input.value.length);
+    }
+
+    public blur(): void {
+        this.input.blur();
+    }
+
+    public release(): void {
+        this.input.remove();
+    }
+
+    private onInput = (event: Event): void => {
+        const value = this.input.value;
+        const previous = this.lastValue;
+        let prefix = 0;
+        while (prefix < value.length && prefix < previous.length && value[prefix] === previous[prefix]) {
+            prefix++;
+        }
+        for (let i = previous.length - prefix; i > 0; i--) {
+            this.sendKey(KeyEvent.KEYCODE_DEL);
+        }
+        const inserted = value.slice(prefix);
+        if (inserted) {
+            this.target.sendMessage(new TextControlMessage(inserted));
+        }
+        this.lastValue = value;
+        if (!(event as InputEvent).isComposing && (!value.startsWith(SENTINEL) || value.length > 64)) {
+            this.reset();
+        }
+    };
+
+    private onKeyDown = (event: KeyboardEvent): void => {
+        // Physical keys with a code are sent by KeyInputHandler, which also blocks the default insertion
+        if (KeyToCodeMap.get(event.code) || event.key !== 'Enter') {
+            return;
+        }
+        event.preventDefault();
+        this.sendKey(KeyEvent.KEYCODE_ENTER);
+        this.reset();
+    };
+
+    private reset(): void {
+        this.input.value = SENTINEL;
+        this.lastValue = SENTINEL;
+    }
+
+    private sendKey(keyCode: number): void {
+        this.target.sendMessage(new KeyCodeControlMessage(KeyEvent.ACTION_DOWN, keyCode, 0, 0));
+        this.target.sendMessage(new KeyCodeControlMessage(KeyEvent.ACTION_UP, keyCode, 0, 0));
+    }
+}
